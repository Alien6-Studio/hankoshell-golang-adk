{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanko.sh/schemas/integration-v1.schema.json",
  "title": "Hanko product integration contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "realm",
    "issuer",
    "client_id",
    "audience",
    "environment_keys"
  ],
  "properties": {
    "schema": { "const": "hanko/integration/v1" },
    "realm": { "type": "string", "minLength": 1 },
    "issuer": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.+/realms/[^/]+$"
    },
    "client_id": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "environment_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "client_id", "client_secret", "audience"],
      "properties": {
        "issuer": { "const": "HANKO_ISSUER" },
        "client_id": { "const": "HANKO_CLIENT_ID" },
        "client_secret": { "const": "HANKO_CLIENT_SECRET" },
        "audience": { "const": "HANKO_AUDIENCE" }
      }
    }
  }
}
